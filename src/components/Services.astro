---
import { site } from '../data/site';
const { services } = site;
---
<section class="wrap section" id="services">
  <div class="section-head">
    <p class="kicker">{services.kicker}</p>
    <h2>{services.title}</h2>
  </div>
  <div class="plans">
    {services.items.map((item) => (
      <article class="plan">
        <p class="kicker">{item.scope}</p>
        <h3>{item.title}</h3>
        <p>{item.body}</p>
      </article>
    ))}
  </div>
</section>
